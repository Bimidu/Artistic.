# ASD Detection System - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Cloud Storage Configuration (HuggingFace Hub)
# ============================================================================

# Enable/disable cloud storage
USE_CLOUD_STORAGE=True

# Fallback to local storage if cloud fails
CLOUD_FALLBACK_LOCAL=True

# HuggingFace repository names (create these on huggingface.co)
# Format: username/repo-name or organization/repo-name
HF_DATASET_REPO=your-username/artistic-asd-datasets
HF_MODEL_REPO=your-username/artistic-asd-models

# HuggingFace authentication token (get from https://huggingface.co/settings/tokens)
# Leave empty to use cached token from ~/.cache/huggingface/token
# Or set it here for automatic authentication (recommended)
# Example: HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN=

# Automatically sync models to cloud after training
CLOUD_AUTO_SYNC=False

# ============================================================================
# Local Storage Paths
# ============================================================================

DATA_DIR=./data
OUTPUT_DIR=./output
MODELS_DIR=./models
LOGS_DIR=./logs
CACHE_DIR=./cache
ASSETS_DIR=./assets

# ============================================================================
# Feature Extraction Configuration
# ============================================================================

MIN_UTTERANCES=10
MIN_WORDS=5
WINDOW_SIZE=300

# ============================================================================
# Processing Configuration
# ============================================================================

N_JOBS=4
BATCH_SIZE=32
CACHE_ENABLED=True

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
